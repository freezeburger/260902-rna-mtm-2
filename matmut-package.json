{
  "name": "mamatmut",
  "main": "expo-router/entry",
  "version": "3.12.2",
  "workspaces": [
    "./libs/lib-authentification-1.1.1"
  ],
  "scripts": {
    "preinstall": "npx only-allow yarn",
    "postinstall": "patch-package",
    "prepare": "lefthook install || true",
    "prebuild:android:development": "APP_ENV=development expo prebuild --clean --platform android",
    "prebuild:android:integration": "APP_ENV=integration expo prebuild --clean --platform android",
    "prebuild:android:recette": "APP_ENV=recette expo prebuild --clean --platform android",
    "prebuild:android:recette-sqli": "WITH_ROZENITE=true APP_ENV=recette-sqli expo prebuild --clean --platform android",
    "prebuild:android:recette-sqli:without-clean": "WITH_ROZENITE=true APP_ENV=recette-sqli expo prebuild --platform android",
    "prebuild:android:production": "APP_ENV=production expo prebuild --clean --platform android",
    "prebuild:ios:development": "APP_ENV=development expo prebuild --clean --platform ios",
    "prebuild:ios:integration": "APP_ENV=integration expo prebuild --clean --platform ios",
    "prebuild:ios:recette": "APP_ENV=recette expo prebuild --clean --platform ios",
    "prebuild:ios:recette-sqli": "WITH_ROZENITE=true APP_ENV=recette-sqli expo prebuild --clean --platform ios",
    "prebuild:ios:recette-sqli:without-clean": "WITH_ROZENITE=true APP_ENV=recette-sqli expo prebuild --platform ios",
    "prebuild:ios:production": "APP_ENV=production expo prebuild --clean --platform ios",
    "run:ios:development": "APP_ENV=development expo run:ios",
    "run:ios:integration": "APP_ENV=integration expo run:ios",
    "run:ios:recette": "APP_ENV=recette expo run:ios",
    "run:ios:recette-sqli": "WITH_ROZENITE=true APP_ENV=recette-sqli expo run:ios --device",
    "run:android:development": "APP_ENV=development expo run:android",
    "run:android:integration": "APP_ENV=integration expo run:android",
    "run:android:recette": "APP_ENV=recette expo run:android",
    "run:android:recette-sqli": "WITH_ROZENITE=true APP_ENV=recette-sqli expo run:android --device",
    "run:ios:recette-sqli:release": "APP_ENV=recette-sqli SENTRY_DISABLE_AUTO_UPLOAD=true expo run:ios --configuration Release --no-bundler",
    "run:android:recette-sqli:release": "APP_ENV=recette-sqli SENTRY_DISABLE_AUTO_UPLOAD=true expo run:android --variant release --no-bundler",
    "run:ios:production": "APP_ENV=production expo run:ios",
    "run:android:production": "APP_ENV=production expo run:android",
    "start:development": "APP_ENV=development expo start",
    "start:integration": "APP_ENV=integration expo start",
    "start:recette": "APP_ENV=recette expo start",
    "start:recette-sqli": "WITH_ROZENITE=true APP_ENV=recette-sqli expo start",
    "start:production": "APP_ENV=production expo start",
    "build:recette": "APP_ENV=recette expo build",
    "build:recette-sqli": "APP_ENV=recette-sqli expo build",
    "build:production": "APP_ENV=production expo build",

    "prettier": "prettier --check .",
    "format": "prettier --write .",
    "tsc": "tsc --skipLibCheck",
    "test": "jest",
    "test-accounts": "npx tsx scripts/test-accounts.ts",
    "prepare:development": "cp $MAMATMUT_CONFIG/okta.dev.json .okta.json && cp $MAMATMUT_CONFIG/MatmutDEV.cer certificates/MatmutDEV.cer",
    "prepare:integration": "cp $MAMATMUT_CONFIG/okta.int.json .okta.json",
    "prepare:recette": "cp $MAMATMUT_CONFIG/okta.rct.json .okta.json",
    "prepare:production": "cp $MAMATMUT_CONFIG/okta.prd.json .okta.json"
  },
  "dependencies": {
    "@commandersact/tcconsent-react-native": "git+https://github.com/sqli/tcconsent-react-native.git#master",
    "@commandersact/tccore-react-native": "git+https://github.com/sqli/tccore-react-native.git",

    "@config-plugins/react-native-blob-util": "^12.0.0",
    "@config-plugins/react-native-pdf": "^12.0.0",
    "@contentsquare/react-native-bridge": "^6.3.0",

    "@encelade/lib-authentification": "workspace:*",

    "@expo/vector-icons": "^15.0.2",

    "@gorhom/bottom-sheet": "^5",

    "@hookform/resolvers": "^5.2.2",

    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",

    "@react-navigation/drawer": "^7.3.9",

    "@sentry/react-native": "~7.11.0",

    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",

    "expo-blur": "~56.0.3",
    "expo-camera": "~56.0.8",
    "expo-checkbox": "~56.0.1",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.20",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",

    "expo-image-manipulator": "~56.0.19",
    "expo-image-picker": "~56.0.18",

    "expo-local-authentication": "~56.0.4",
    "expo-location": "~56.0.18",
    "expo-notifications": "~56.0.18",

    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.18",
    "expo-store-review": "~56.0.3",

    "i18next": "^25.5.2",

    "piano-analytics-js": "^6.16.4",

    "pushwoosh-expo-plugin": "^2.0.4",
    "pushwoosh-react-native-plugin": "^6.1.49",

    "react-hook-form": "^7.65.0",

    "react-i18next": "^15.7.3",

    "react-native-blob-util": "^0.22.2",
    "react-native-device-info": "^14.1.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-maps": "1.27.2",
    "react-native-menus": "^0.3.0",
    "react-native-pdf": "^7.0.3",

    "react-native-sortables": "^1.9.4",
    "react-native-ssl-pinning": "1.6.0",
    "react-native-svg": "15.15.4",
    "react-native-svg-transformer": "^1.5.1",
    "react-native-webview": "13.16.1",

    "@reduxjs/toolkit": "^2.9.0",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",

    "tsx": "^4.20.5",
    "typed-openapi": "^2.2.2",
    
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@jest/globals": "30.3.0",
    "@react-native/jest-preset": "0.85.3",
    "@rozenite/metro": "1.7.0",
    "@rozenite/react-navigation-plugin": "1.8.0",
    "@rozenite/redux-devtools-plugin": "1.9.0",
    "@testing-library/react-native": "13.3.3",
    "@types/crypto-js": "4.2.2",
    "@types/jest": "29.5.14",
    "@types/node": "24.12.2",
    "@types/react": "~19.2.14",
    "babel-preset-expo": "56.0.15",
    "danger": "13.0.10",
    "danger-plugin-coverage": "1.6.2",
    "danger-plugin-node-dependencies": "0.0.2",
    "eslint": "9.36.0",
    "eslint-config-expo": "56.0.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.15.4",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-testing-library": "7.16.2",
    "jest": "29.7.0",
    "jest-expo": "56.0.5",
    "jest-sonar-reporter": "2.0.0",
    "lefthook": "2.1.10",
    "patch-package": "8.0.1",
    "prettier": "3.8.5",
    "react-test-renderer": "19.2.3",
    "ts-jest": "29.4.12",
    "tsc-files": "1.1.4",
    "typescript": "6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-worklets/jest/resolver.js",
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/setup.ts"
    ],
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "src/**/*.{ts,tsx}",
      "!**/testAccountsConstants.ts",
      "!**/showcases/**",
      "!**/mocks/**"
    ],
    "testPathIgnorePatterns": [
      "/__tests__/setup.ts"
    ],
    "testResultsProcessor": "jest-sonar-reporter",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|react-redux|@reduxjs/.*|immer|pushwoosh-react-native-plugin|@commandersact/.*|@contentsquare/.*)"
    ]
  },
  "jestSonar": {
    "sonar56x": true,
    "reportFile": "test-report.xml",
    "indent": 4
  },
  "packageManager": "yarn@4.9.4"
}
 